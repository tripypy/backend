{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "ko_text": { "type": "standard" },
        "ko_autocomplete": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "edge_ngram_filter"]
        }
      },
      "filter": {
        "edge_ngram_filter": { "type": "edge_ngram", "min_gram": 1, "max_gram": 20 }
      }
    }
  },
  "mappings": {
    "dynamic": "false",
    "properties": {
      "spotId": { "type": "long" },
      "kakaoPlaceId": { "type": "keyword" },

      "name": {
        "type": "text",
        "analyzer": "ko_text",
        "fields": {
          "keyword": { "type": "keyword" },
          "autocomplete": { "type": "text", "analyzer": "ko_autocomplete", "search_analyzer": "ko_text" }
        }
      },
      "address": { "type": "text", "analyzer": "ko_text", "fields": { "keyword": { "type": "keyword" } } },
      "category": { "type": "keyword" },

      "location": { "type": "geo_point" },
      "lat": { "type": "double" },
      "lng": { "type": "double" },

      "placeUrl": { "type": "keyword" },
      "thumbnailUrl": { "type": "keyword" },

      "reviewCount": { "type": "integer" },
      "averageRating": { "type": "scaled_float", "scaling_factor": 100 },

      "createdAt": { "type": "date" }
    }
  }
}
